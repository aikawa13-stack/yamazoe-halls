rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isManager() {
      return isAdmin() && request.auth.token.role == "manager" && request.auth.token.facility == "all";
    }

    function managesFacility(facility) {
      return isManager() || (isAdmin() && request.auth.token.role == "staff" && request.auth.token.facility == facility);
    }

    function isValidRoom(facility, room) {
      return (facility == "higashiyama" && room in [
               "higashiyama_1f_large_meeting_room", "higashiyama_1f_cooking_practice_room",
               "higashiyama_2f_large_japanese_room", "higashiyama_2f_small_japanese_room",
               "higashiyama_2f_training_room"
             ]) ||
             (facility == "hatano" && room == "hatano_training_room") ||
             (facility == "toyohara" && room in [
               "toyohara_large_training_room", "toyohara_training_room", "toyohara_cooking_practice_room"
             ]);
    }

    function isValidReservation(slotId) {
      return request.resource.data.keys().hasAll([
               "slotId", "facility", "room", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "slotId", "facility", "room", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night", "all_day"] &&
             request.resource.data.customerName is string &&
             request.resource.data.customerName.size() >= 1 &&
             request.resource.data.customerName.size() <= 80 &&
             request.resource.data.phone is string &&
             request.resource.data.phone.size() >= 8 &&
             request.resource.data.phone.size() <= 30 &&
             request.resource.data.purpose is string &&
             request.resource.data.purpose.size() >= 1 &&
             request.resource.data.purpose.size() <= 200 &&
             request.resource.data.notes is string &&
             request.resource.data.notes.size() <= 500 &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    function isValidAvailability(slotId) {
      return request.resource.data.keys().hasAll([
               "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night", "all_day"] &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    function isClosedDay(facility, date) {
      return exists(/databases/$(database)/documents/closed_days/$(facility)/dates/$(date));
    }

    // The document ID fixes the facility, room, date, and usage category. A slot
    // can be created once, which prevents a duplicate public submission.
    match /reservations/{slotId} {
      // Public creation must atomically add the matching non-private
      // availability record. This keeps reservation details private.
      allow create: if request.auth == null && resource == null &&
        isValidReservation(slotId) &&
        !isClosedDay(request.resource.data.facility, request.resource.data.date) &&
        getAfter(/databases/$(database)/documents/availability/$(slotId)).data.slotId == slotId;

      allow read, update, delete: if managesFacility(resource.data.facility);
    }

    match /availability/{slotId} {
      // This collection contains only slot status and is safe to expose.
      allow read: if true;
      allow create: if managesFacility(request.resource.data.facility) || (request.auth == null && resource == null &&
        isValidAvailability(slotId) &&
        getAfter(/databases/$(database)/documents/reservations/$(slotId)).data.slotId == slotId &&
        getAfter(/databases/$(database)/documents/reservations/$(slotId)).data.status == "pending");
      allow update, delete: if managesFacility(resource.data.facility);
    }

    match /closed_days/{facility}/dates/{date} {
      // A closure contains no personal data and is used by the public calendar.
      allow read: if true;
      allow create, update, delete: if managesFacility(facility);
    }

    // The public form has no access to other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
