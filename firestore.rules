rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidReservation(slotId) {
      return request.resource.data.keys().hasAll([
               "slotId", "facility", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "slotId", "facility", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["東山", "波多野", "豊原"] &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["午前", "午後", "夜間", "全日"] &&
             request.resource.data.customerName is string &&
             request.resource.data.customerName.size() >= 1 &&
             request.resource.data.customerName.size() <= 80 &&
             request.resource.data.phone is string &&
             request.resource.data.phone.size() >= 8 &&
             request.resource.data.phone.size() <= 30 &&
             request.resource.data.purpose is string &&
             request.resource.data.purpose.size() >= 1 &&
             request.resource.data.purpose.size() <= 200 &&
             request.resource.data.notes is string &&
             request.resource.data.notes.size() <= 500 &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    function isValidAvailability(slotId) {
      return request.resource.data.keys().hasAll([
               "slotId", "facility", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "slotId", "facility", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["東山", "波多野", "豊原"] &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["午前", "午後", "夜間", "全日"] &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    // The document ID fixes the facility, date, and usage category. A slot
    // can be created once, which prevents a duplicate public submission.
    match /reservations/{slotId} {
      // Public creation must atomically add the matching non-private
      // availability record. This keeps reservation details private.
      allow create: if request.auth == null && resource == null &&
        isValidReservation(slotId) &&
        getAfter(/databases/$(database)/documents/availability/$(slotId)).data.slotId == slotId;

      // Staff access is available only to ID tokens carrying admin: true.
      allow read, update, delete: if isAdmin();
    }

    match /availability/{slotId} {
      // This collection contains only slot status and is safe to expose.
      allow read: if true;
      allow create: if isAdmin() || (request.auth == null && resource == null &&
        isValidAvailability(slotId) &&
        getAfter(/databases/$(database)/documents/reservations/$(slotId)).data.slotId == slotId &&
        getAfter(/databases/$(database)/documents/reservations/$(slotId)).data.status == "pending");
      allow update, delete: if isAdmin();
    }

    // The public form has no access to other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
