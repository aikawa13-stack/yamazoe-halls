rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isManager() {
      return isAdmin() && request.auth.token.role == "manager" && request.auth.token.facility == "all";
    }

    function managesFacility(facility) {
      return isManager() || (isAdmin() && request.auth.token.role == "staff" && request.auth.token.facility == facility);
    }

    // A visitor is normally anonymous, but an authenticated staff member can
    // also open the public form from the same browser session. In that case,
    // retain the public-form validation and limit staff to their own facility.
    function canSubmitPublicReservation(facility) {
      return request.auth == null || (isAdmin() && managesFacility(facility));
    }

    function isValidRoom(facility, room) {
      return (facility == "higashiyama" && room in [
               "higashiyama_1f_large_meeting_room", "higashiyama_1f_cooking_practice_room",
               "higashiyama_2f_large_japanese_room", "higashiyama_2f_small_japanese_room",
               "higashiyama_2f_training_room"
             ]) ||
             (facility == "hatano" && room == "hatano_training_room") ||
             (facility == "toyohara" && room in [
               "toyohara_large_training_room", "toyohara_training_room", "toyohara_cooking_practice_room"
             ]);
    }

    function isValidReservation(reservationId) {
      return request.resource.data.keys().hasAll([
               "reservationId", "slotId", "facility", "room", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "reservationId", "slotId", "facility", "room", "date", "slot", "customerName",
               "phone", "purpose", "notes", "status", "createdAt"
             ]) &&
             request.resource.data.reservationId == reservationId &&
             (reservationId == request.resource.data.slotId || reservationId.matches("^" + request.resource.data.slotId + "__[A-Za-z0-9-]+$")) &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night", "all_day"] &&
             request.resource.data.customerName is string &&
             request.resource.data.customerName.size() >= 1 &&
             request.resource.data.customerName.size() <= 80 &&
             request.resource.data.phone is string &&
             request.resource.data.phone.matches("^[0-9]{10,30}$") &&
             request.resource.data.purpose is string &&
             request.resource.data.purpose.size() >= 1 &&
             request.resource.data.purpose.size() <= 200 &&
             request.resource.data.notes is string &&
             request.resource.data.notes.size() <= 500 &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    function isValidAvailability(slotId) {
      return request.resource.data.keys().hasAll([
               "reservationId", "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "reservationId", "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.reservationId is string &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night", "all_day"] &&
             request.resource.data.status == "pending" &&
             request.resource.data.createdAt == request.time;
    }

    function isValidStaffReservation(reservationId) {
      return request.resource.data.keys().hasAll([
               "reservationId", "slotId", "facility", "room", "date", "slot", "customerName", "phone",
               "purpose", "notes", "status", "isStaffReservation", "createdBy", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "reservationId", "slotId", "facility", "room", "date", "slot", "customerName", "phone",
               "purpose", "notes", "status", "isStaffReservation", "createdBy", "createdAt"
             ]) &&
             request.resource.data.reservationId == reservationId &&
             (reservationId == request.resource.data.slotId || reservationId.matches("^" + request.resource.data.slotId + "__[A-Za-z0-9-]+$")) &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night"] &&
             request.resource.data.customerName is string && request.resource.data.customerName.size() <= 80 &&
             request.resource.data.phone is string &&
             (request.resource.data.phone == "" || request.resource.data.phone.matches("^[0-9]{10,30}$")) &&
             request.resource.data.purpose is string && request.resource.data.purpose.size() >= 1 && request.resource.data.purpose.size() <= 200 &&
             request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
             request.resource.data.status == "confirmed" && request.resource.data.isStaffReservation == true &&
             request.resource.data.createdBy == request.auth.token.email &&
             request.resource.data.createdAt == request.time;
    }

    function isValidStaffAvailability(slotId) {
      return request.resource.data.keys().hasAll([
               "reservationId", "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "reservationId", "slotId", "facility", "room", "date", "slot", "status", "createdAt"
             ]) &&
             request.resource.data.slotId == slotId &&
             request.resource.data.reservationId is string &&
             request.resource.data.slotId == request.resource.data.facility + "_" + request.resource.data.room + "_" + request.resource.data.date + "_" + request.resource.data.slot &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night"] &&
             request.resource.data.status == "confirmed" && request.resource.data.createdAt == request.time;
    }

    function isValidReservationAudit() {
      return request.resource.data.keys().hasOnly([
               "action", "reservationId", "facility", "room", "date", "slot", "performedBy", "performedAt"
             ]) &&
             request.resource.data.action in ["create", "update", "delete", "restore"] &&
             request.resource.data.reservationId is string &&
             request.resource.data.facility in ["higashiyama", "hatano", "toyohara"] &&
             isValidRoom(request.resource.data.facility, request.resource.data.room) &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.slot in ["morning", "afternoon", "night", "all_day"] &&
             request.resource.data.performedBy == request.auth.token.email &&
             request.resource.data.performedAt == request.time;
    }

    function isValidClosedDay(closedDayId) {
      return request.resource.data.keys().hasAll([
               "facilityId", "date", "weekday", "isHoliday", "holidayName", "createdBy", "createdAt"
             ]) &&
             request.resource.data.keys().hasOnly([
               "facilityId", "date", "weekday", "isHoliday", "holidayName", "createdBy", "createdAt"
             ]) &&
             closedDayId.matches("^(higashiyama|hatano|toyohara)_[0-9]{8}$") &&
             request.resource.data.facilityId in ["higashiyama", "hatano", "toyohara"] &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.weekday in ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] &&
             request.resource.data.isHoliday is bool &&
             request.resource.data.holidayName is string &&
             request.resource.data.holidayName.size() <= 80 &&
             request.resource.data.createdBy == request.auth.token.email &&
             request.resource.data.createdAt == request.time;
    }

    function isValidClosureAvailability(closureId) {
      return request.resource.data.keys().hasOnly(["facilityId", "date"]) &&
             request.resource.data.facilityId in ["higashiyama", "hatano", "toyohara"] &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             closureId == request.resource.data.facilityId + "_" + request.resource.data.date;
    }

    function isValidClosureAudit() {
      return request.resource.data.keys().hasOnly(["action", "facilityId", "date", "deletedBy", "deletedAt"]) &&
             request.resource.data.action == "delete" &&
             request.resource.data.facilityId in ["higashiyama", "hatano", "toyohara"] &&
             request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") &&
             request.resource.data.deletedBy == request.auth.token.email &&
             request.resource.data.deletedAt == request.time;
    }

    function isClosedDay(facility, date) {
      return exists(/databases/$(database)/documents/closureAvailability/$(facility + "_" + date)) ||
             exists(/databases/$(database)/documents/closed_days/$(facility)/dates/$(date));
    }

    function isStoppedDay(facility, room, date) {
      return exists(/databases/$(database)/documents/stopped_days/$(facility)/rooms/$(room)/dates/$(date));
    }

    // slotId identifies the bookable slot; reservationId identifies one entry in
    // its history stack. The availability document names the currently active one.
    match /reservations/{reservationId} {
      // Public creation must atomically add the matching non-private
      // availability record. This keeps reservation details private.
      allow create: if (canSubmitPublicReservation(request.resource.data.facility) && resource == null &&
        isValidReservation(reservationId) &&
        !isClosedDay(request.resource.data.facility, request.resource.data.date) &&
        !isStoppedDay(request.resource.data.facility, request.resource.data.room, request.resource.data.date) &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.slotId == request.resource.data.slotId &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.reservationId == reservationId &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.status == "pending") ||
        (isAdmin() && resource == null && managesFacility(request.resource.data.facility) &&
        isValidStaffReservation(reservationId) &&
        !isClosedDay(request.resource.data.facility, request.resource.data.date) &&
        !isStoppedDay(request.resource.data.facility, request.resource.data.room, request.resource.data.date) &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.slotId == request.resource.data.slotId &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.reservationId == reservationId &&
        getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.status == "confirmed");

      allow read, update: if managesFacility(resource.data.facility);
      allow delete: if isManager();
    }

    match /availability/{slotId} {
      // This collection contains only slot status and is safe to expose.
      allow read: if true;
      allow create: if (isAdmin() && managesFacility(request.resource.data.facility) &&
        isValidStaffAvailability(slotId) &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.slotId == slotId &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.status == "confirmed") || (canSubmitPublicReservation(request.resource.data.facility) && resource == null &&
        isValidAvailability(slotId) &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.slotId == slotId &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.status == "pending");
      allow update: if managesFacility(resource.data.facility) || (canSubmitPublicReservation(request.resource.data.facility) &&
        resource.data.status == "available" && isValidAvailability(slotId) &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.slotId == slotId &&
        getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.status == "pending");
      allow delete: if isManager();
    }

    match /closedDays/{closedDayId} {
      // Staff-only data includes the member who registered the closure.
      allow read: if managesFacility(resource.data.facilityId);
      allow create: if managesFacility(request.resource.data.facilityId) && isValidClosedDay(closedDayId);
      allow delete: if managesFacility(resource.data.facilityId);
    }

    match /closureAvailability/{closureId} {
      // Public calendar data deliberately excludes staff email and audit fields.
      allow read: if true;
      allow create: if managesFacility(request.resource.data.facilityId) && isValidClosureAvailability(closureId);
      allow delete: if managesFacility(resource.data.facilityId);
    }

    // Public calendar projections. The nested date collections preserve the
    // facility and room hierarchy while keeping private staff metadata hidden.
    match /closed_days/{facilityId}/dates/{date} {
      allow read: if true;
      allow create, update: if managesFacility(facilityId) &&
        request.resource.data.keys().hasOnly(["facilityId", "date"]) &&
        request.resource.data.facilityId == facilityId && request.resource.data.date == date;
      allow delete: if managesFacility(facilityId);
    }

    match /stopped_days/{facilityId}/rooms/{roomId}/dates/{date} {
      allow read: if true;
      allow create, update: if managesFacility(facilityId) && isValidRoom(facilityId, roomId) &&
        request.resource.data.keys().hasOnly(["facilityId", "room", "date", "createdBy", "createdAt"]) &&
        request.resource.data.facilityId == facilityId && request.resource.data.room == roomId &&
        request.resource.data.date == date && request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.createdAt == request.time;
      allow delete: if managesFacility(facilityId);
    }

    match /closedDayAuditLogs/{auditId} {
      allow read: if managesFacility(resource.data.facilityId);
      allow create: if managesFacility(request.resource.data.facilityId) && isValidClosureAudit();
    }

    match /reservationAuditLogs/{auditId} {
      allow read: if managesFacility(resource.data.facility);
      allow create: if managesFacility(request.resource.data.facility) && isValidReservationAudit();
    }

    // The public form has no access to other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
