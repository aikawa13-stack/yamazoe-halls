# Non-secret staging settings. Copy this file to .env.yamazoe-halls-staging
# for local Firebase CLI deployments. Do not commit the copied file.
APP_ENV=staging
APP_TIME_ZONE=Asia/Tokyo
FUNCTION_REGION=asia-northeast1

# The Google Calendar ID shared with the Calendar service account.
# Set to "primary" only if the service account has an explicitly shared primary calendar.
GOOGLE_CALENDAR_ID=REPLACE_WITH_SHARED_CALENDAR_ID

# Comma-separated public origins permitted to call the API.
ALLOWED_ORIGINS=https://yamazoe-halls-staging.web.app
