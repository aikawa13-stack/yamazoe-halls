{
  "name": "yamazoe-halls-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting,storage",
    "deploy": "firebase deploy --only functions,hosting,firestore:rules,firestore:indexes,storage",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
